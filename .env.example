# Time zone your work hours are written in.
TZ=America/Los_Angeles

# The address you open Dayloop at. Google sends you back here after sign-in,
# so it must match the redirect URI on your OAuth client (BASE_URL + /oauth/callback).
BASE_URL=http://localhost:8787

# From Google Cloud Console (see README). Leave empty to run without Google Calendar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Name of the calendar Dayloop creates for its blocks.
CALENDAR_NAME=Dayloop

# Daily database backups: how many to keep. In Docker they are written to
# ./backups next to docker-compose.yml.
BACKUP_KEEP=14
